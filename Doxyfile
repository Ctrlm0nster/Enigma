# Doxyfile for Enigma Workbench

PROJECT_NAME           = "Enigma Workbench"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Interactive historical Enigma machine simulator built with C++20 and Raylib"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
RESOLVE_UNNAMED_PARAMS = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = YES

# Input paths
INPUT                  = documentation/Mainpage.md \
                         include \
                         src \
                         documentation \
                         README.md \
                         assets/ATTRIBUTION.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.h \
                         *.c \
                         *.md
RECURSIVE              = YES
EXCLUDE                = build \
                         libs \
                         _deps
EXCLUDE_PATTERNS       = */build/* \
                         */libs/* \
                         */_deps/*
USE_MDFILE_AS_MAINPAGE = documentation/Mainpage.md

# Source Browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES

# HTML Output & Styling
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_EXTRA_STYLESHEET  = documentation/doxygen-custom.css
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
TREEVIEW_WIDTH         = 250
FORMULA_FONTSIZE       = 12
SEARCHENGINE           = YES

# Mermaid Support
MERMAID_RENDER_MODE    = CLIENT_SIDE
MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs

# Disable LaTeX by default for lightweight generation
GENERATE_LATEX         = NO

# Graphviz / Dot Integration
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DIRECTORY_GRAPH        = YES
DOT_CLEANUP            = YES
